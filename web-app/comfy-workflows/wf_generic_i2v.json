{
  "_meta": {
    "title": "Generic I2V hook (API format) — S7 video",
    "description": "Scaffold for image-to-video. Real I2V graphs differ by custom node (SVD / Wan / MiniMax wrappers). Keep placeholders; replace middle nodes with your local graph exported as API format.",
    "placeholders": [
      "__POSITIVE__",
      "__NEGATIVE__",
      "__SEED__",
      "__WIDTH__",
      "__HEIGHT__",
      "__STEPS__",
      "__CFG__",
      "__REF_IMAGE__",
      "__FILENAME_PREFIX__",
      "__CKPT__"
    ],
    "notes": [
      "LoadImage reads from ComfyUI input folder — upload ref via ComfyUI UI or POST /upload/image first.",
      "This default graph is still T2I+LoadImage wired as a stub so /prompt validates topology on stock installs; swap node 10/11 for your I2V sampler pack.",
      "For MiniMax H3 cloud, keep using S5 shells and skip local S7."
    ]
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "__REF_IMAGE__"
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "__CKPT__"
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "__WIDTH__",
      "height": "__HEIGHT__",
      "batch_size": 1
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "__POSITIVE__",
      "clip": ["4", 1]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "__NEGATIVE__",
      "clip": ["4", 1]
    }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "__SEED__",
      "steps": "__STEPS__",
      "cfg": "__CFG__",
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["3", 0],
      "vae": ["4", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "__FILENAME_PREFIX__",
      "images": ["8", 0]
    }
  }
}
