{
  "_meta": {
    "title": "Storyboard still (API format) — S6 keyframe",
    "description": "Same topology as asset T2I; separate file so you can point stills at a different checkpoint/LoRA graph.",
    "placeholders": [
      "__POSITIVE__",
      "__NEGATIVE__",
      "__SEED__",
      "__WIDTH__",
      "__HEIGHT__",
      "__STEPS__",
      "__CFG__",
      "__FILENAME_PREFIX__",
      "__CKPT__"
    ]
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "__CKPT__"
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "__WIDTH__",
      "height": "__HEIGHT__",
      "batch_size": 1
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "__POSITIVE__",
      "clip": ["4", 1]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "__NEGATIVE__",
      "clip": ["4", 1]
    }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "__SEED__",
      "steps": "__STEPS__",
      "cfg": "__CFG__",
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["3", 0],
      "vae": ["4", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "__FILENAME_PREFIX__",
      "images": ["8", 0]
    }
  }
}
