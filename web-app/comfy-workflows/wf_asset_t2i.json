{
  "_meta": {
    "title": "Asset T2I (API format) — character/scene still",
    "description": "Generic SDXL-style text-to-image. Replace ckpt_name with your local checkpoint. Placeholders are injected by comfy.js.",
    "placeholders": [
      "__POSITIVE__",
      "__NEGATIVE__",
      "__SEED__",
      "__WIDTH__",
      "__HEIGHT__",
      "__STEPS__",
      "__CFG__",
      "__FILENAME_PREFIX__",
      "__CKPT__"
    ],
    "notes": [
      "Export your own graph as API format from ComfyUI (Save API Format) and keep the same placeholder strings in CLIPTextEncode / EmptyLatentImage / KSampler / SaveImage.",
      "Default ckpt is a placeholder string — change __CKPT__ via settings or edit this file.",
      "21+ fictional NSFW only; keep underage tokens in negative."
    ]
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "__CKPT__"
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "__WIDTH__",
      "height": "__HEIGHT__",
      "batch_size": 1
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "__POSITIVE__",
      "clip": ["4", 1]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "__NEGATIVE__",
      "clip": ["4", 1]
    }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "__SEED__",
      "steps": "__STEPS__",
      "cfg": "__CFG__",
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["3", 0],
      "vae": ["4", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "__FILENAME_PREFIX__",
      "images": ["8", 0]
    }
  }
}
